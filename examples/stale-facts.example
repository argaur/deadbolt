# Copy to .stale-facts at your repo root, then run scripts/stale-doc-check.sh.
# One rule per line: <extended regex> ::: <what is true now>
# Name facts that were true and stopped being true. This is not a style gate.

# Skip history. Old records must keep saying what was true when they were written.
exclude changelog
exclude docs/archive

